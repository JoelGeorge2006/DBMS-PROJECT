# Copy to .env and fill in. Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# URL-encode special characters in the password (# -> %23, @ -> %40). Never commit .env.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
